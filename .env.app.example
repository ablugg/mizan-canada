# .env.app — bundled inside the distributed Electron app.
# Copy to .env.app and fill in values before building.
# DO NOT include GITHUB_TOKEN or any admin credentials here.

# SQLite database path (set at runtime by electron/main.ts — leave blank here)
DATABASE_URL=

# Enclave bridge (optional — for the privacy enclave feature)
ENCLAVE_BRIDGE_URL=
ENCLAVE_CID=
BRIDGE_SECRET=

# Field-level encryption key for sensitive DB columns
FIELD_ENCRYPTION_KEY=

# Law pack distribution repo (public read — no token needed for downloads)
GITHUB_LAWS_REPO=ablugg/mizan-laws
