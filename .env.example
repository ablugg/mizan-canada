# Required
DATABASE_URL="file:./prisma/dev.db"

# Ollama — defaults shown, override if Ollama runs on a non-standard port
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector store path — defaults to ./data/vector-store
# VECTOR_DB_PATH=./data/vector-store

# Canadian law source repo (cloned during vector build)
# GITHUB_LAWS_REPO=justicecanada/laws-lois-xml

# GITHUB_TOKEN=github_pat_...
